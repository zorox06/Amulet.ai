# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Or direct Supabase Postgres connection string (Transaction pooler / Direct):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google Gemini API Key (for LLM-based intelligent fix generation and migration analysis)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=

# Detection and Gemini model
EXA_API_KEY=
EXA_LIVE=true
GEMINI_FIX_MODEL=gemini-3.6-flash

# GitHub App Configuration (installation-token flow; never commit the PEM)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_REPO=owner/repository
GITHUB_BASE=main
OPEN_PR=false

# Clerk Authentication (Get keys at https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server Configuration
PORT=3000
